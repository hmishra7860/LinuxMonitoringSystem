# --- required ---
DATABASE_URL=postgresql://linuxwatch:linuxwatch@db:5432/linuxwatch
# Long random string used to sign login tokens and derive the secret-encryption key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
LW_SECRET_KEY=change-me-to-a-long-random-string
# --- optional ---
# Fernet key for encrypting integration secrets (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# If empty, a key is derived from LW_SECRET_KEY.
LW_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ACCESS_TOKEN_HOURS=12
REMEMBER_ME_DAYS=30
OFFLINE_AFTER_SEC=90
METRIC_RETENTION_DAYS=30
LOG_RETENTION_DAYS=14
# Webhook/Slack/Teams URLs resolving to private IPs are blocked (SSRF protection). Set true only for internal webhooks.
ALLOW_PRIVATE_WEBHOOKS=false
# Public URL of this API, used in agent install commands.
PUBLIC_URL=http://localhost:8000
